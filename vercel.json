{
  "rewrites": [
    {
      "source": "/confirmed",
      "destination": "/confirmed.html"
    },
    {
      "source": "/thank-you",
      "destination": "/confirmed.html"
    },
    {
      "source": "/appointment-success",
      "destination": "/confirmed.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ]
}